# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "PrusaSlicer")
set(SLIC3R_APP_KEY "PrusaSlicer")
set(SLIC3R_VERSION "2.9.6")
set(ROTATRIX_RELEASE_VERSION "${SLIC3R_VERSION}-rotatrix.1-beta.2")
set(ROTATRIX_SOURCE_REVISION "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=10 HEAD
        WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}"
        OUTPUT_VARIABLE ROTATRIX_GIT_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET RESULT_VARIABLE ROTATRIX_GIT_RESULT)
    if(ROTATRIX_GIT_RESULT EQUAL 0)
        set(ROTATRIX_SOURCE_REVISION "${ROTATRIX_GIT_REVISION}")
    endif()
endif()
set(SLIC3R_BUILD_ID "PrusaSlicer-${ROTATRIX_RELEASE_VERSION}+${ROTATRIX_SOURCE_REVISION}")
set(SLIC3R_RC_VERSION "2,9,6,0")
set(SLIC3R_RC_VERSION_DOTS "2.9.6.0")
